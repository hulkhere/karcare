# Shopify store domain
SHOPIFY_STORE=1t2gmb-fi.myshopify.com

# Option A (Dev Dashboard app): client credentials. The app exchanges these for a
# short-lived access token automatically. Needs read_orders + read_all_orders scopes.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Option B: a static Admin API token (shpat_...). If set, it takes precedence.
SHOPIFY_ACCESS_TOKEN=

# Optional: Admin API version (default 2026-07)
# SHOPIFY_API_VERSION=2026-07

# Password for the app login screen (required in production)
APP_PASSWORD=

# Monthly archive storage (Upstash Redis). Vercel's Upstash integration sets these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Secret Vercel Cron sends when auto-closing each month. Any long random string.
CRON_SECRET=

# First month the archive tracks, and the invoice number it starts from.
ARCHIVE_START_MONTH=2026-08
ARCHIVE_START_NUMBER=1
